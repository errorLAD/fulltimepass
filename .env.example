# ==============================================================================
# FullTimePass.in — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel, add these variables under: Project Settings -> Environment Variables.
# NOTE: Do NOT commit your production credentials or secret keys to git.

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (Prisma + PostgreSQL)
# ------------------------------------------------------------------------------
# Provide a PostgreSQL connection string from Neon (recommended for Vercel),
# Supabase, Railway, Vercel Postgres, or AWS RDS.
#
# Serverless Tip (Connection Pooling):
# If using Supabase or Neon with connection pooling, use port 6543 / pooled URL:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
#
# For local development with Docker or local PostgreSQL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/fulltimepass?schema=public"

# Optional direct connection URL for Prisma CLI migrations when using pooled DATABASE_URL:
# DIRECT_URL="postgresql://postgres:password@localhost:5432/fulltimepass?schema=public"

# ------------------------------------------------------------------------------
# 2. APPLICATION URL & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
# Used for canonical links, sitemap generation, OpenGraph previews, and WhatsApp sharing:
NEXT_PUBLIC_APP_URL="https://fulltimepass.in"

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
NODE_ENV="production"
